---
import { getSiteConfig } from '../../config/site-config';
import SectionHeading from '../ui/SectionHeading.astro';
const siteConfig = getSiteConfig(Astro.url.pathname);
const ui = siteConfig.ui;
---
<section class="section"><div class="container results-grid"><SectionHeading eyebrow={ui.resultsEyebrow} title={ui.resultsTitle} description={ui.resultsDescription} /><ul class="check-list">{siteConfig.results.map((result) => <li><span aria-hidden="true">✓</span>{result}</li>)}</ul></div></section>
