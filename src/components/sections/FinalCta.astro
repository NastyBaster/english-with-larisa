---
import { getSiteConfig } from '../../config/site-config';
import ButtonLink from '../ui/ButtonLink.astro';
const siteConfig = getSiteConfig(Astro.url.pathname);
const ui = siteConfig.ui;
---
<section class="final-cta"><div class="container"><div class="cta-card"><div><p class="eyebrow">{ui.finalCtaEyebrow}</p><h2>{ui.finalCtaTitle}</h2><p>{ui.finalCtaDescription}</p></div><ButtonLink href={siteConfig.contact.messengerUrl} external>{siteConfig.contact.messengerLabel}</ButtonLink><span class="cta-doodle" aria-hidden="true">hello!</span></div></div></section>
