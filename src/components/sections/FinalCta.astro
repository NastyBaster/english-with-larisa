---
import { siteConfig } from '../../config/site';
import ButtonLink from '../ui/ButtonLink.astro';
---
<section class="final-cta"><div class="container"><div class="cta-card"><div><p class="eyebrow">Готові почати?</p><h2>Зробіть перший крок до впевненої англійської</h2><p>Коротко напишіть про свою ціль. Я відповім, зорієнтую щодо формату та наступних кроків.</p></div><ButtonLink href={siteConfig.contact.messengerUrl} external>{siteConfig.contact.messengerLabel}</ButtonLink><span class="cta-doodle" aria-hidden="true">hello!</span></div></div></section>
