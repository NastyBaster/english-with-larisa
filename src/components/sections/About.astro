---
import { getSiteConfig } from '../../config/site-config';
import SectionHeading from '../ui/SectionHeading.astro';

const siteConfig = getSiteConfig(Astro.url.pathname);
const ui = siteConfig.ui;
const aboutPhoto = siteConfig.tutor.aboutPhoto ?? siteConfig.tutor.photo;
const photoSrc = aboutPhoto
  ? `${import.meta.env.BASE_URL}/${aboutPhoto.replace(/^\//, '')}`
  : null;
---

<section class="section section--tint" id="about">
  <div class="container about-grid">
    <div class="about-photo">
      {
        photoSrc ? (
          <img
            class="about-photo-image"
            src={photoSrc}
            alt={siteConfig.tutor.photoAlt}
            width="880"
            height="940"
            loading="lazy"
            style={`object-position: ${siteConfig.tutor.aboutPhotoPosition}`}
          />
        ) : (
          <div
            class="photo-placeholder photo-placeholder--about"
            role="img"
            aria-label="Місце для фотографії викладачки"
          >
            <span>Ваше фото</span>
            <small>живий професійний портрет</small>
          </div>
        )
      }

      <div class="about-sticker">
        let’s speak<br />
        <strong>English!</strong>
      </div>
    </div>

    <div>
      <SectionHeading
        eyebrow={ui.aboutEyebrow}
        title={`${ui.aboutTitle} ${siteConfig.tutor.name}`}
      />

      {
        siteConfig.tutor.bio.map((paragraph) => (
          <p class="about-copy">{paragraph}</p>
        ))
      }

      <div class="principle">
        <span aria-hidden="true">“</span>
        <p>
          {ui.principle}
        </p>
      </div>
    </div>
  </div>
</section>
