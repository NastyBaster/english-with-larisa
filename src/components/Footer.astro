---
import { siteConfig } from '../config/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div><a class="brand brand--footer" href="/"><span class="brand-mark">EN</span><span><strong>{siteConfig.tutor.name}</strong><small>{siteConfig.tutor.role}</small></span></a></div>
    <div><p class="footer-label">Навігація</p>{siteConfig.navigation.slice(0, 4).map((item) => <a href={item.href}>{item.label}</a>)}</div>
    <div><p class="footer-label">Контакти</p><a href={siteConfig.contact.messengerUrl} target="_blank" rel="noopener noreferrer">{siteConfig.contact.messengerLabel}</a>{siteConfig.contact.email && <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>}</div>
  </div>
  <div class="container footer-bottom"><p>© {new Date().getFullYear()} {siteConfig.tutor.name}</p><a href="/privacy/">Політика конфіденційності</a></div>
</footer>
