---
interface Props { eyebrow?: string; title: string; description?: string; centered?: boolean }
const { eyebrow, title, description, centered = false } = Astro.props;
---
<div class:list={['section-heading', { 'section-heading--centered': centered }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</div>
