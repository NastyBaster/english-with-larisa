---
import { siteConfig } from '../config/site';
import ButtonLink from './ui/ButtonLink.astro';

const homeUrl = `${import.meta.env.BASE_URL}/`;
const navigationUrl = (href: string) => (href.startsWith('#') ? `${homeUrl}${href}` : href);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeUrl} aria-label={`${siteConfig.tutor.name} — на головну`}>
      <span class="brand-mark" aria-hidden="true">EN</span>
      <span><strong>{siteConfig.tutor.name}</strong><small>{siteConfig.tutor.role}</small></span>
    </a>
    <nav aria-label="Основна навігація">
      <ul>{siteConfig.navigation.map((item) => <li><a href={navigationUrl(item.href)}>{item.label}</a></li>)}</ul>
    </nav>
    <ButtonLink href={siteConfig.contact.messengerUrl} external class="header-cta">Зв’язатися</ButtonLink>
  </div>
</header>
